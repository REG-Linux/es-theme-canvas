{
  "views": {
    "system": {
      "id": "system",
      "children": [
        {
          "type": "repeat",
          "id": "imagegrid",
          "source": "systems",
          "grid": "$system.imagegrid.grid@sysgridsize",
          "cursor": {"duration": 250},
          "template": {
            "id": "tile",
            "children": [{"use": "container"}],
            "style": {"scale": 1.0},
            "states": {
              "selected": {
                "style": {"scale": 1.0499},
                "transitions": {"scale": {"duration": 150, "easing": "easeOutQuad"}}
              }
            },
            "transitions": {"scale": {"duration": 250, "easing": "easeOutQuad"}}
          },
          "style": {
            "position": "absolute",
            "left": "0.8%",
            "top": "8%",
            "width": "98.5%",
            "height": "85%",
            "zIndex": 2.0,
            "flexDirection": "row",
            "flexWrap": "wrap",
            "overflow": "hidden",
            "columnGap": "0vw",
            "rowGap": "0vh",
            "padding": ["0vh", "0vw", "0vh", "0vw"]
          },
          "if": {"system-view": ["grid"]}
        },
        {
          "type": "image",
          "id": "gamesicon",
          "src": "../_inc/images/icons/gamescount.svg",
          "style": {
            "position": "absolute",
            "left": "3%",
            "top": "2%",
            "width": "2.8%",
            "zIndex": 5.0
          },
          "replayShown": true,
          "tint": "$systemInfoColor"
        },
        {
          "type": "text",
          "id": "systemInfo",
          "font": "../_inc/fonts/Inter-Bold.otf",
          "fontSize": "2.8vmin",
          "align": "left",
          "valign": "center",
          "lineHeight": 1.5,
          "style": {
            "position": "absolute",
            "left": "7%",
            "top": "2%",
            "width": "30%",
            "height": "2.8%",
            "opacity": 0.0,
            "zIndex": 4.0,
            "color": "$systemInfoColor"
          },
          "replayShown": true
        },
        {"use": "background-art", "replayShown": true},
        {"use": "help"},
        {
          "type": "repeat",
          "id": "systemcarousel",
          "source": "systems",
          "cursor": {
            "loop": true,
            "axis": "horizontal",
            "window": 3.0,
            "duration": 500.0,
            "easing": "easeOutQuint"
          },
          "template": {
            "id": "entry",
            "style": {
              "position": "absolute",
              "left": "{50 + item.distance * 33.3333 + (item.distance < -0.5 ? -0.666667 : item.distance > 0.5 ? 0.666667 : 0)}%",
              "top": "50%",
              "width": "40.8%",
              "height": "55.2%",
              "translate": ["-50%", "-50%"],
              "transformOrigin": ["50%", "50%"],
              "scale": "{min(1.2, max(1, 1 + 0.2 * (1 - abs(item.distance)))) / 1.2}",
              "opacity": "{max(204, round(204 + 51 * (1 - abs(item.distance)))) / 255}"
            },
            "children": [
              {
                "type": "image",
                "id": "shade",
                "fit": "contain",
                "position": ["50%", "50%"],
                "src": "../_inc/images/backgrounds/4-5-bg.webp",
                "style": {
                  "position": "absolute",
                  "left": "50%",
                  "top": "50%",
                  "maxWidth": "100%",
                  "maxHeight": "100%",
                  "translate": ["-50%", "-50%"],
                  "opacity": 0.6,
                  "zIndex": 2.0
                }
              },
              {"use": "backdrop", "tint": "#291c0aff"},
              {
                "type": "image",
                "id": "systemBack",
                "fit": "contain",
                "position": ["50%", "50%"],
                "src": "{firstFile(\"$(themeDir)/../_inc/systems/carousel-icons-icons/\" + item.theme + \".webp\",\"$(themeDir)/../_inc/systems/carousel-icons-icons/_default.webp\")}",
                "style": {
                  "position": "absolute",
                  "left": "50%",
                  "top": "45%",
                  "maxWidth": "75%",
                  "maxHeight": "80%",
                  "translate": ["-50%", "-50%"],
                  "zIndex": 2.0,
                  "opacity": 0.8999
                },
                "states": {"selected": "$selected.systemBack"},
                "transitions": {"opacity": {"duration": 250, "easing": "easeOutQuad"}}
              },
              {
                "type": "text",
                "id": "systemyear",
                "text": "{item.releaseYear}",
                "font": "../_inc/fonts/Inter-Regular.otf",
                "fontSize": "2.6vmin",
                "align": "center",
                "valign": "center",
                "transform": "uppercase",
                "lineHeight": 1.5,
                "wrap": true,
                "style": {
                  "position": "absolute",
                  "left": "50%",
                  "top": "78%",
                  "width": "50%",
                  "height": "20%",
                  "translate": ["-50%", "-0%"],
                  "zIndex": 4.0,
                  "color": "#ffffffff"
                }
              },
              {"use": "fallbackText", "style": {"top": "72%", "color": "#ffffffff"}},
              {
                "type": "image",
                "id": "theLogoImage",
                "fit": "contain",
                "position": ["50%", "100%"],
                "src": "../_inc/systems/logos/{item.theme}.svg",
                "style": {
                  "position": "absolute",
                  "left": "50%",
                  "top": "80%",
                  "maxWidth": "45%",
                  "maxHeight": "20%",
                  "translate": ["-50%", "-100%"],
                  "zIndex": 5.0
                }
              }
            ]
          },
          "style": {
            "position": "absolute",
            "left": "50%",
            "top": "48%",
            "width": "100%",
            "height": "100%",
            "translate": ["-50%", "-50%"],
            "zIndex": 40.0,
            "overflow": "hidden"
          },
          "if": {"system-view": ["carousel"]}
        }
      ]
    }
  }
}

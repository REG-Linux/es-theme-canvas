{
  "views": {
    "gamelist/basic": {
      "id": "basic",
      "children": [
        {"use": "gamelist"},
        {"use": "background-art"},
        {"use": "game-list-background-shadow"},
        {"use": "game-list-background"},
        {
          "use": "logo",
          "style": {
            "top": "$gamelist/basic.logo.style.top@env.dualScreen",
            "maxWidth": "$gamelist/basic.logo.style.maxWidth@env.dualScreen",
            "maxHeight": "$gamelist/basic.logo.style.maxHeight@env.dualScreen"
          }
        },
        {"use": "logoText"},
        {"use": "help"},
        {
          "type": "image",
          "id": "console-icon",
          "fit": "contain",
          "position": ["0%", "0%"],
          "style": {
            "position": "absolute",
            "left": "25.5%",
            "top": "75%",
            "maxWidth": "45%",
            "maxHeight": "25%"
          },
          "if": {"aspect-ratio": ["4-3"]}
        }
      ]
    }
  }
}

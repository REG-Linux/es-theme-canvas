{
  "views": {
    "gamelist/gamecarousel": {
      "id": "gamecarousel",
      "children": [
        {
          "type": "repeat",
          "id": "gamecarousel",
          "source": "games",
          "cursor": "$gamelist/gamecarousel.gamecarousel.cursor",
          "template": {
            "id": "entry",
            "style": {
              "position": "absolute",
              "left": "50%",
              "top": "50%",
              "width": "$gamelist/gamecarousel.gamecarousel.template.style.width@font-size",
              "height": "$gamelist/gamecarousel.gamecarousel.template.style.height@font-size",
              "translate": ["-50%", "-50%"],
              "transformOrigin": ["50%", "50%"],
              "scale": "{min(1.2, max(1, 1 + 0.2 * (1 - abs(item.distance)))) / 1.2}",
              "opacity": "{max(127.5, round(127.5 + 127.5 * (1 - abs(item.distance)))) / 255}"
            },
            "children": [
              {
                "id": "wheel",
                "style": {
                  "position": "absolute",
                  "left": 0,
                  "top": 0,
                  "width": "100%",
                  "height": "100%",
                  "rotate": "{-7 * item.distance}",
                  "transformOrigin": ["500%", "50%"]
                },
                "children": [
                  {
                    "type": "image",
                    "id": "logo",
                    "src": "{firstFile(item.marquee)}",
                    "fit": "contain",
                    "style": {
                      "position": "absolute",
                      "left": 0,
                      "top": 0,
                      "width": "100%",
                      "height": "100%"
                    }
                  },
                  {
                    "type": "text",
                    "id": "label",
                    "text": "{item.name}",
                    "fontSize": "8.5vmin",
                    "align": "center",
                    "valign": "center",
                    "lineHeight": 1.5,
                    "wrap": true,
                    "style": {
                      "position": "absolute",
                      "left": "0%",
                      "top": "0%",
                      "width": "100%",
                      "height": "100%",
                      "color": "#000000ff"
                    },
                    "visible": "{firstFile(item.marquee) == \"\"}"
                  },
                  {
                    "id": "badges",
                    "visible": "{item.badges != \"\" || (system.showFlags != 0 && item.regionFlag != \"\")}",
                    "style": {
                      "position": "absolute",
                      "flexDirection": "row",
                      "alignItems": "center",
                      "right": "4%",
                      "top": "4%",
                      "zIndex": 2,
                      "background": "#000000b3",
                      "borderRadius": "0.6vmin",
                      "padding": ["0.3vmin", "0.6vmin", "0.3vmin", "0.6vmin"]
                    },
                    "children": [
                      {
                        "type": "image",
                        "id": "flag",
                        "src": "{item.regionFlag}",
                        "fit": "contain",
                        "style": {
                          "width": "{max(12, 0.04 * min(screen.w, screen.h)) * 4 / 3}",
                          "height": "{max(12, 0.04 * min(screen.w, screen.h))}",
                          "flexShrink": 0,
                          "margin": [0, "0.4vmin", 0, 0],
                          "display": "{system.showFlags != 0 && item.regionFlag != \"\" ? \"flex\" : \"none\"}"
                        }
                      },
                      {
                        "type": "text",
                        "id": "icons",
                        "text": "{item.badges}",
                        "font": ":/fontawesome-webfont.ttf",
                        "fontSize": "{max(12, 0.04 * min(screen.w, screen.h))}",
                        "style": {"color": "#ffffffff"}
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "style": {
            "position": "absolute",
            "left": "2.2%",
            "top": "-18%",
            "width": "145%",
            "height": "130%",
            "zIndex": 2.0,
            "overflow": "hidden"
          }
        },
        {"use": "background-art"},
        {"use": "playtime-logo"},
        {"use": "game-metadata-background-shadow-base"},
        {"use": "game-metadata-background-image-base"},
        {"use": "md_video"},
        {"use": "md_releasedate"},
        {"use": "md_lastplayed"},
        {"use": "md_name"},
        {"use": "md_players"},
        {"use": "md_genre"},
        {"use": "md_developer"},
        {"use": "md_publisher"},
        {"use": "md_playcount"},
        {"use": "md_gametime_custom"},
        {"use": "md_rating"},
        {"use": "md_description"},
        {"use": "logo"},
        {"use": "logoText"},
        {"use": "help"},
        {"use": "game-metadata-background-shadow-extended"},
        {"use": "game-metadata-background-image-extended"},
        {"use": "md_marquee"},
        {"use": "md_image"},
        {"use": "md_thumbnail"}
      ]
    }
  }
}

{
  "views": {
    "secondarygamelist": {
      "id": "secondarygamelist",
      "children": [
        {"use": "sec-background"},
        {
          "type": "image",
          "id": "sec-shot",
          "fit": "contain",
          "position": ["50%", "50%"],
          "src": "{firstFile(game.image, game.thumbnail)}",
          "style": {
            "position": "absolute",
            "left": "50%",
            "top": "31%",
            "maxWidth": "92%",
            "maxHeight": "58%",
            "translate": ["-50%", "-50%"],
            "zIndex": 2.0
          }
        },
        {
          "type": "box",
          "id": "sec-video",
          "style": {
            "position": "absolute",
            "left": "50%",
            "top": "31%",
            "translate": ["-50%", "-50%"],
            "zIndex": 7.0
          }
        },
        {
          "type": "box",
          "id": "sec-game-panel",
          "style": {
            "position": "absolute",
            "left": "2%",
            "top": "61.5%",
            "width": "96%",
            "height": "37%",
            "zIndex": 3.0,
            "background": "$color-scheme/background.1",
            "borderRadius": 12.0
          }
        },
        {
          "type": "text",
          "id": "sec-name",
          "text": "{textDefault(game.name)}",
          "font": "../_inc/fonts/Inter-Bold.otf",
          "fontSize": "4.5vmin",
          "align": "left",
          "valign": "center",
          "lineHeight": 1.5,
          "style": {
            "position": "absolute",
            "left": "4%",
            "top": "63%",
            "width": "92%",
            "height": "6%",
            "zIndex": 4.0,
            "color": "$secTextColor"
          }
        },
        {
          "type": "text",
          "id": "sec-facts",
          "text": "{textDefault(game.releaseYear)}",
          "font": "../_inc/fonts/Inter-Regular.otf",
          "fontSize": "3.2vmin",
          "align": "left",
          "valign": "center",
          "lineHeight": 1.5,
          "style": {
            "position": "absolute",
            "left": "4%",
            "top": "69%",
            "width": "12%",
            "height": "4%",
            "zIndex": 4.0,
            "color": "$secTextColor"
          }
        },
        {
          "type": "text",
          "id": "sec-developer",
          "text": "{textDefault(game.developer)}",
          "font": "../_inc/fonts/Inter-Regular.otf",
          "fontSize": "3.2vmin",
          "align": "left",
          "valign": "center",
          "lineHeight": 1.5,
          "style": {
            "position": "absolute",
            "left": "16%",
            "top": "69%",
            "width": "36%",
            "height": "4%",
            "zIndex": 4.0,
            "color": "$secTextColor"
          }
        },
        {
          "type": "text",
          "id": "sec-genre",
          "text": "{textDefault(game.genre)}",
          "font": "../_inc/fonts/Inter-Regular.otf",
          "fontSize": "3.2vmin",
          "align": "left",
          "valign": "center",
          "lineHeight": 1.5,
          "style": {
            "position": "absolute",
            "left": "52%",
            "top": "69%",
            "width": "26%",
            "height": "4%",
            "zIndex": 4.0,
            "color": "$secTextColor"
          }
        },
        {
          "type": "text",
          "id": "sec-players",
          "text": "{textDefault(game.players)}",
          "font": "../_inc/fonts/Inter-Regular.otf",
          "fontSize": "3.2vmin",
          "align": "right",
          "valign": "center",
          "lineHeight": 1.5,
          "style": {
            "position": "absolute",
            "left": "78%",
            "top": "69%",
            "width": "18%",
            "height": "4%",
            "zIndex": 4.0,
            "color": "$secTextColor"
          }
        },
        {
          "type": "box",
          "id": "sec-rating",
          "style": {
            "position": "absolute",
            "left": "4%",
            "top": "74%",
            "height": "3%",
            "zIndex": 3.0
          }
        },
        {
          "type": "text",
          "id": "sec-description",
          "text": "{textDefault(game.desc)}",
          "font": "../_inc/fonts/Inter-Regular.otf",
          "fontSize": "3vmin",
          "align": "left",
          "valign": "top",
          "lineHeight": 1.2,
          "wrap": true,
          "style": {
            "position": "absolute",
            "left": "4%",
            "top": "79%",
            "width": "92%",
            "height": "19%",
            "zIndex": 4.0,
            "color": "$secTextColor"
          }
        }
      ]
    }
  }
}

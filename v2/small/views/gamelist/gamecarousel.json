{
  "views": {
    "gamelist/gamecarousel": {
      "id": "gamecarousel",
      "children": [
        {
          "type": "repeat",
          "id": "gamecarousel",
          "source": "games",
          "cursor": "$gamelist/gamecarousel.gamecarousel.cursor",
          "template": {
            "id": "entry",
            "style": {
              "position": "absolute",
              "left": "50%",
              "top": "50%",
              "width": "$gamelist/gamecarousel.gamecarousel.template.style.width",
              "height": "$gamelist/gamecarousel.gamecarousel.template.style.height",
              "translate": ["-50%", "-50%"],
              "transformOrigin": ["50%", "50%"],
              "scale": "{min(1.2, max(1, 1 + 0.2 * (1 - abs(item.distance)))) / 1.2}",
              "opacity": "{max(127.5, round(127.5 + 127.5 * (1 - abs(item.distance)))) / 255}"
            },
            "children": [
              {
                "id": "wheel",
                "style": {
                  "position": "absolute",
                  "left": 0,
                  "top": 0,
                  "width": "100%",
                  "height": "100%",
                  "rotate": "{-7 * item.distance}",
                  "transformOrigin": ["500%", "50%"]
                },
                "children": [
                  {
                    "type": "image",
                    "id": "logo",
                    "src": "{firstFile(item.marquee)}",
                    "fit": "contain",
                    "style": {
                      "position": "absolute",
                      "left": 0,
                      "top": 0,
                      "width": "100%",
                      "height": "100%"
                    }
                  },
                  {
                    "type": "text",
                    "id": "label",
                    "text": "{item.name}",
                    "fontSize": "8.5vmin",
                    "align": "center",
                    "valign": "center",
                    "lineHeight": 1.5,
                    "wrap": true,
                    "style": {
                      "position": "absolute",
                      "left": "0%",
                      "top": "0%",
                      "width": "100%",
                      "height": "100%",
                      "color": "#000000ff"
                    },
                    "visible": "{firstFile(item.marquee) == \"\"}"
                  }
                ]
              }
            ]
          },
          "style": {
            "position": "absolute",
            "left": "2.2%",
            "top": "-18%",
            "width": "145%",
            "height": "130%",
            "zIndex": 2.0,
            "overflow": "hidden"
          }
        },
        {"use": "background-art"},
        {"use": "playtime-logo"},
        {"use": "game-metadata-background-shadow-base"},
        {"use": "game-metadata-background-image-base"},
        {"use": "md_video"},
        {"use": "md_releasedate"},
        {"use": "md_lastplayed"},
        {"use": "md_name"},
        {"use": "md_players"},
        {"use": "md_genre"},
        {"use": "md_developer"},
        {"use": "md_publisher"},
        {"use": "md_playcount"},
        {"use": "md_gametime_custom"},
        {"use": "md_rating"},
        {"use": "md_description"},
        {"use": "logo"},
        {"use": "logoText"},
        {"use": "help"},
        {"use": "game-metadata-background-shadow-extended"},
        {"use": "game-metadata-background-image-extended"}
      ]
    }
  }
}

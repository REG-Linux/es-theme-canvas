        {"use": "game-list-background-shadow"},
        {"use": "game-list-background"},
        {"use": "logo", "style": {"top": "50%", "maxWidth": "35%", "maxHeight": "35%"}},
        {"use": "logoText"},
        {"use": "help"}
      ]
    }
  }
}

      "children": [
        {"use": "star1", "src": "../../_inc/images/icons/icon-star-filled.svg"},
        {"use": "star2", "src": "../../_inc/images/icons/icon-star-filled.svg"},
        {"use": "star3", "src": "../../_inc/images/icons/icon-star-filled.svg"},
        {"use": "star4", "src": "../../_inc/images/icons/icon-star-filled.svg"},
        {"use": "star5", "src": "../../_inc/images/icons/icon-star-filled.svg"}
      ],
      "id": "md_rating-filled"
    },

      "lineHeight": 1.2,
      "style": {
        "position": "absolute",
        "left": "$font-size/left.8",
        "top": "$font-size/top.6",
        "translate": ["-0%", "-50%"],
        "zIndex": 40.0,
        "color": "$gameMetadataColor",
        "width": "$font-size/width.8",
        "height": "$font-size/height.6"
      }

      "font": "../../_inc/fonts/Inter-Regular.otf",
      "fontSize": "$font-size/fontSize.2",
      "valign": "center",
      "lineHeight": 1.2,
      "style": {
        "position": "absolute",
        "left": "$font-size/left.6",
        "top": "$font-size/top.6",
        "translate": ["-0%", "-50%"],
        "zIndex": 40.0,
        "color": "$gameMetadataColor",
        "width": "$font-size/width.5",

        "height": "{(menu.subtitle != \"\" ? ((fontCapHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.0333333 * min(screen.w, screen.h)), 1) + 0.05 * screen.h) + 0.019 * screen.h) * ((fontCapHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.0333333 * min(screen.w, screen.h)), 1) + 0.05 * screen.h) + (textHeight(\"$(themeDir)/../../_inc/fonts/Inter-Regular.otf\", (0.0145833 * min(screen.w, screen.h)), 1, menu.subtitle, 0.88 * screen.w, 1.1) + 0.019 * screen.h)) / (fontCapHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.0333333 * min(screen.w, screen.h)), 1) + 0.05 * screen.h) : (menu.subtitle != \"\" ? (fontCapHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.0333333 * min(screen.w, screen.h)), 1) + 0.05 * screen.h) + 0.019 * screen.h : fontCapHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.0333333 * min(screen.w, screen.h)), 1) + 0.0637 * screen.h)) - (menu.subtitle != \"\" ? (fontCapHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.0333333 * min(screen.w, screen.h)), 1) + 0.05 * screen.h) + 0.019 * screen.h : fontCapHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.0333333 * min(screen.w, screen.h)), 1) + 0.0637 * screen.h)}"
      },
      "wrap": true,
      "visible": "{menu.subtitle != \"\"}"
    },

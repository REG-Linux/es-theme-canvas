    "md_releasedate": {
      "type": "text",
      "id": "md_releasedate",
      "text": "{game.releasedate != \"\" ? game.releasedate : tr(\"Unknown\")}",
      "font": "../../_inc/fonts/Inter-Regular.otf",
      "fontSize": "$metadata/fontSize.1",
      "valign": "center",
      "lineHeight": 1.2,
      "style": {
        "position": "absolute",
        "left": "$metadata/left.3",
        "top": "$metadata/top.4",
        "width": "$metadata/width.3",
        "height": "$metadata/height.4",

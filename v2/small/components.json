        "position": "absolute",
        "left": "50%",
        "top": "50%",
        "width": "100%",
        "height": "100%",
        "translate": ["-50%", "-50%"],
        "zIndex": 1.0
      }
    },
    // used by dialog, menu
    "dim": {
      "type": "image",
      "id": "dim",
      "src": ":/scroll_gradient.png",

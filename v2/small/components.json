      "lineHeight": "$metadata/lineHeight.1",
      "wrap": true,
      "style": {
        "position": "absolute",
        "left": "$metadata/left.2",
        "top": "$metadata/top.8",
        "width": "$metadata/width.8",
        "height": "$metadata/height.9",
        "translate": ["-50%", "-0%"],

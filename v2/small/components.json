// Generated by regstation --theme-convert from the theme's ES files.
// Plain JSON with comments: edit freely, or convert again (which writes these files anew).
// Paths (images, fonts) are relative to the directory of theme.json.
// Shared nodes: {"use": name} places one; the node's own keys go over it (style key by key, null unsets).
{
  "defs": {
    // used by menu
    "description": {
      "type": "text",
      "id": "description",
      "text": "{item.description}",
      "font": "$(themeDir)/../../_inc/fonts/Inter-Regular.otf",
      "fontMenu": true,
      "fontSize": "1.45833vmin",
      "align": "left",
      "valign": "top",
      "lineHeight": 1.5,
      "style": {
        "height": "{1.1 * fontHeight(\"$(themeDir)/../../_inc/fonts/Inter-Regular.otf\", (0.0145833 * min(screen.w, screen.h)), 1) * 1.5}",
        "flexShrink": 0,
        "color": "$color-scheme/color.1",
        "display": "{true ? \"flex\" : \"none\"}"
      },
      "states": {"selected": {"style": {"color": "$color-scheme/color.2"}}}
    },
    // used by def container, system
    "fallbackText": {
      "type": "text",
      "id": "fallbackText",
      "visible": "{!exists(\"$(themeDir)/../../_inc/systems/logos/\" + item.theme + \".svg\")}",
      "text": "{item.fullName}",
      "font": "../../_inc/fonts/Inter-Bold.otf",
      "fontSize": "$system.imagegrid.template.container.container-content.container.fallbackText.fontSize",
      "align": "center",
      "valign": "center",
      "transform": "uppercase",
      "lineHeight": 1.5,
      "wrap": true,
      "style": {
        "position": "absolute",
        "left": "50%",
        "top": "78%",
        "width": "60%",
        "height": "20%",
        "translate": ["-50%", "-50%"],
        "zIndex": 4.0,
        "color": "$systemInfoColor"
      }
    },
    // used by menu
    "labelTop": {
      "type": "text",
      "id": "labelTop",
      "text": "{item.label}",
      "font": "$(themeDir)/../../_inc/fonts/Inter-Bold.otf",
      "fontMenu": true,
      "fontSize": "2.5vmin",
      "align": "left",
      "valign": "top",
      "lineHeight": 1.5,
      "style": {
        "height": "{0.9 * fontHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.025 * min(screen.w, screen.h)), 1) * 1.5}",
        "flexShrink": 0,
        "color": "$menuTextColor",
        "display": "{true ? \"flex\" : \"none\"}"
      },
      "states": {"selected": {"style": {"color": "$gamelistSelectedColor"}}}
    },
    // used by def container, system
    "backdrop": {
      "type": "image",
      "id": "backdrop",
      "fit": "contain",
      "position": ["50%", "50%"],
      "src": "../../_inc/images/icons/icon.webp",
      "tint": "$BackdropColor",
      "style": {
        "position": "absolute",
        "left": "50%",
        "top": "50%",
        "maxWidth": "100%",
        "maxHeight": "100%",
        "translate": ["-50%", "-50%"],
        "opacity": 0.6,
        "zIndex": 2.0
      }
    },
    // used by def buttons
    "buttonLabel": {
      "type": "text",
      "id": "buttonLabel",
      "text": "{item.label}",
      "font": "$(themeDir)/../../_inc/fonts/Inter-Bold.otf",
      "fontMenu": true,
      "fontSize": "2.5vmin",
      "align": "center",
      "valign": "center",
      "lineHeight": 1.5,
      "style": {
        "position": "absolute",
        "left": 0,
        "top": 0,
        "width": "100%",
        "height": "100%",
        "color": "$menuTextColor"
      },
      "states": {"selected": {"style": {"color": "$gamelistSelectedColor"}}}
    },
    // used by system
    "container": {
      "type": "box",
      "id": "container",
      "style": {"position": "absolute", "left": 0, "top": 0, "width": "100%", "height": "100%"},
      "children": [
        {
          "id": "container-content",
          "style": {
            "position": "absolute",
            "left": 10.0,
            "top": 10.0,
            "right": 10.0,
            "bottom": 10.0
          },
          "children": [
            {
              "type": "image",
              "id": "selector",
              "fit": "contain",
              "position": ["50%", "50%"],
              "src": "../../_inc/images/backgrounds/4-5.webp",
              "style": {
                "position": "absolute",
                "left": "50%",
                "top": "50%",
                "maxWidth": "100%",
                "maxHeight": "100%",
                "translate": ["-50%", "-50%"],
                "zIndex": 8.0
              },
              "tint": "#00000000",
              "states": {
                "selected": {
                  "animations": "$system.imagegrid.template.container.container-content.selector.states.selected.animations",
                  "style": {}
                }
              }
            },
            {"use": "backdrop"},
            {
              "type": "image",
              "id": "shade",
              "fit": "contain",
              "position": ["50%", "50%"],
              "src": "../../_inc/images/backgrounds/4-5-bg.webp",
              "style": {
                "position": "absolute",
                "left": "50%",
                "top": "50%",
                "maxWidth": "100%",
                "maxHeight": "100%",
                "translate": ["-50%", "-50%"],
                "opacity": 0.6,
                "zIndex": 2.0
              }
            },
            {
              "type": "image",
              "id": "systemBack",
              "fit": "contain",
              "position": ["50%", "50%"],
              "src": "{firstFile(\"$(themeDir)/../../_inc/systems/carousel-icons-icons/\" + item.theme + \".webp\",\"$(themeDir)/../../_inc/systems/carousel-icons-icons/_default.webp\")}",
              "style": {
                "position": "absolute",
                "left": "50%",
                "top": "45%",
                "maxWidth": "80%",
                "maxHeight": "90%",
                "translate": ["-50%", "-50%"],
                "zIndex": 2.0,
                "opacity": 0.8999
              },
              "states": {"selected": "$selected.systemBack"},
              "transitions": {"opacity": {"duration": 250, "easing": "easeOutQuad"}}
            },
            {
              "type": "image",
              "id": "theLogoImage",
              "fit": "contain",
              "position": ["50%", "50%"],
              "src": "../../_inc/systems/logos/{item.theme}.svg",
              "style": {
                "position": "absolute",
                "left": "50%",
                "top": "72%",
                "maxWidth": "45%",
                "maxHeight": "25%",
                "translate": ["-50%", "-50%"],
                "zIndex": 5.0
              },
              "tint": "$systemInfoColor"
            },
            {
              "type": "box",
              "id": "container",
              "style": {
                "position": "absolute",
                "left": 0,
                "top": 0,
                "width": "100%",
                "height": "100%",
                "opacity": 0.8999
              },
              "states": {"selected": {"style": {"opacity": 1.0}}},
              "transitions": {"opacity": {"duration": 250, "easing": "easeOutQuad"}},
              "children": [{"use": "fallbackText"}]
            }
          ],
          "if": {"icon-scheme": ["icon"]}
        },
        {
          "type": "image",
          "id": "selector",
          "src": "../../_inc/images/backgrounds/square.svg",
          "style": {
            "position": "absolute",
            "left": "50%",
            "top": "47.5%",
            "width": "65%",
            "height": "84%",
            "translate": ["-50%", "-50%"],
            "zIndex": 8.0
          },
          "tint": "#00000000",
          "states": {
            "selected": {
              "animations": [
                {
                  "property": "tint",
                  "keyframes": [[0, "#ebca8000"], [1000, "#ebca80ff"]],
                  "easing": "easeOutQuad",
                  "loop": true
                },
                {
                  "property": "tint",
                  "keyframes": [[1500, "#ebca80ff"], [2500, "#ebca8000"]],
                  "easing": "easeOutQuad",
                  "loop": true
                }
              ]
            }
          },
          "if": {"icon-scheme": ["art"]}
        },
        {
          "type": "image",
          "id": "shade",
          "fit": "contain",
          "position": ["50%", "100%"],
          "src": "../../_inc/images/backgrounds/square-bg.webp",
          "style": {
            "position": "absolute",
            "left": "50%",
            "top": "77%",
            "maxWidth": "84%",
            "maxHeight": "74%",
            "translate": ["-50%", "-100%"],
            "zIndex": 2.0
          },
          "if": {"icon-scheme": ["art"]}
        },
        {
          "type": "image",
          "id": "systemBack",
          "fit": "contain",
          "position": ["50%", "100%"],
          "src": "{firstFile(\"$(themeDir)/../../_inc/systems/carousel-icons-art/\" + item.theme + \".webp\",\"$(themeDir)/../../_inc/systems/carousel-icons-art/_default.webp\")}",
          "style": {
            "position": "absolute",
            "left": "50%",
            "top": "71%",
            "maxWidth": "74%",
            "maxHeight": "64%",
            "translate": ["-50%", "-100%"],
            "zIndex": 2.0,
            "opacity": 0.8999
          },
          "states": {"selected": "$selected.systemBack"},
          "transitions": {"opacity": {"duration": 250, "easing": "easeOutQuad"}},
          "if": {"icon-scheme": ["art"]}
        },
        {
          "type": "image",
          "id": "theLogoImage",
          "fit": "contain",
          "position": ["50%", "0%"],
          "src": "../../_inc/systems/logos/{item.theme}.svg",
          "style": {
            "position": "absolute",
            "left": "50%",
            "top": "75.5%",
            "maxWidth": "60%",
            "maxHeight": "18%",
            "translate": ["-50%", "-0%"],
            "zIndex": 5.0
          },
          "if": {"icon-scheme": ["art"]}
        },
        {
          "use": "fallbackText",
          "fontSize": "2.6vmin",
          "style": {"top": "85%", "width": "80%", "color": "#ffffffff"},
          "if": {"icon-scheme": ["art"]}
        },
        {
          "type": "box",
          "id": "container",
          "style": {
            "position": "absolute",
            "left": 0,
            "top": 0,
            "width": "100%",
            "height": "100%",
            "opacity": 0.8999
          },
          "states": {"selected": {"style": {"opacity": 1.0}}},
          "transitions": {"opacity": {"duration": 250, "easing": "easeOutQuad"}},
          "if": {"icon-scheme": ["art"]}
        }

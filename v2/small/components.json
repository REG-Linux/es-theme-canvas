    // used by gamelist/detailed, gamelist/gamecarousel, gamelist/grid
    "md_rating": {
      "type": "box",
      "id": "md_rating",
      "style": {
        "position": "absolute",
        "left": "$metadata/left.7",
        "top": "$metadata/top.7",
        "height": "$metadata/height.8",
        "translate": "$metadata/translate.1",
        "zIndex": 3.0,
        "aspectRatio": "$metadata/aspectRatio.1",
        "width": "$metadata/width.7"
      },
      "children": [{"use": "md_rating-unfilled"}, {"use": "md_rating-value"}],
      "visible": "$metadata-option/visible.2"
    },

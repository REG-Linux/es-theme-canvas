apHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.0333333 * min(screen.w, screen.h)), 1) + 0.05 * screen.h) + 0.019 * screen.h : fontCapHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.0333333 * min(screen.w, screen.h)), 1) + 0.0637 * screen.h)) + fontHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.025 * min(screen.w, screen.h)), 1) * 1.5 * 4.2 * 2 + 0.0296 * screen.h * 0.6 + (fontHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.025 * min(screen.w, screen.h)), 1) * 1.5 + 0.0296 * screen.h + (menu.buttons > 0 ? 2 : 0)) + 2)) - (fontHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.025 * min(screen.w, screen.h)), 1) * 1.5 + 0.0296 * screen.h + (menu.buttons > 0 ? 2 : 0)) + 0.0148 * screen.h}",
        "height": "{fontHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.025 * min(screen.w, screen.h)), 1) * 1.5}",
        "flexDirection": "row",
        "justifyContent": "center"
      },
      "template": {
        "id": "button",
        "font": "$(themeDir)/../../_inc/fonts/Inter-Bold.otf",
        "fontMenu": true,
        "fontSize": "2.5vmin",
        "borderImage": "../../_inc/images/menu/button.png",
        "borderImageSlice": 20.0,
        "tint": "$menuTextColor",
        "style": {
          "width": "{max(textWidth(item.label), textWidth(\"DELETE\")) + max(12, 0.014 * screen.w)}",
          "height": "100%",
          "margin": [0, "0.26vw", 0, "0.26vw"]
        },
        "states": {"selected": "$selected.button"},
        "children": [{"use": "buttonLabel"}]
      }
    },
    // used by def md_rating-value
    "md_rating-filled": {
      "type": "box",
      "style": {
        "position": "absolute",
        "left": 0,
        "top": 0,
        "height": "100%",
        "flexDirection": "row",

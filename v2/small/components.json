    // used by gamelist/detailed, gamelist/gamecarousel, gamelist/grid
    "game-metadata-background-shadow-extended": {
      "type": "image",
      "id": "game-metadata-background-shadow-extended",
      "src": "../../_inc/images/detailed/gamelist-metadata-background-shadow-extended.webp",
      "style": {
        "position": "absolute",
        "left": "25.5%",
        "top": "67.06%",
        "width": "49.31%",
        "height": "35.5%",
        "translate": ["-50%", "-50%"],
        "zIndex": 1.0
      },
      "if": {"font-size": ["small"]}
    },
    // used by gamelist/basic, gamelist/detailed
    "gamelist": {
      "type": "repeat",
      "id": "gamelist",
      "source": "games",
      "cursor": {"scroll": "center"},
      "template": {
        "id": "row",
        "style": {"width": "100%", "height": "$font-size/height.2"},
        "children": [
          {"use": "selector"},
          {
            "type": "text",
            "id": "label",
            "text": "{item.name}",
            "font": "../../_inc/fonts/Inter-Regular.otf",
            "fontSize": "2.6vmin",
            "lineHeight": 1.5,
            "align": "left",
            "valign": "center",
            "style": {
              "height": "100%",
              "color": "$gamelistPrimaryColor",
              "margin": [0, "0.8333vw", 0, "0.8333vw"]
            },
            "states": {"selected": {"style": {"color": "$gamelistSelectedColor"}}}
          }
        ]
      },
      "style": {
        "position": "absolute",
        "left": "$font-size/left.1",
        "top": "$font-size/top.1",
        "width": "$font-size/width.1",
        "height": "$font-size/height.1",
        "zIndex": 4.0,
        "flexDirection": "column",
        "overflow": "hidden"
      }
    },
    // used by dialog, gamelist/basic, gamelist/detailed, gamelist/gamecarousel, gamelist/grid, menu, system
    "help": {
      "type": "repeat",
      "id": "help",
      "source": "help",
      "visible": "{screen.statusBar}",
      "font": "../../_inc/fonts/Inter-Bold.otf",
      "fontSize": "2.8vmin",
      "fitItems": true,
      "pinned": true,
      "style": {
        "position": "absolute",
        "left": "50%",
        "top": "97.5%",
        "translate": ["-50%", "-50%"],
        "flexDirection": "row",
        "alignItems": "center",
        "zIndex": 10000,
        "maxWidth": "{settings.DrawClock ? screen.w - textWidth(settings.ClockMode12 ? \"__00:00_AM_\" : \"__00:00_\") : screen.w * (1 - 0.0084)}"
      },
      "template": {
        "id": "entry",
        "font": "../../_inc/fonts/Inter-Bold.otf",
        "fontSize": "2.8vmin",
        "style": {
          "height": "{round(1.25 * self.capHeight)}",
          "flexDirection": "row",
          "alignItems": "center",
          "margin": [0, "0.84vw", 0, 0]
        },
        "children": [{"use": "icon"}, {"use": "label"}]
      }
    },
    // used by gamelist/basic, gamelist/detailed, gamelist/gamecarousel, gamelist/grid
    "logoText": {
      "type": "text",
      "id": "logoText",
      "fontSize": "4.5vmin",
      "align": "center",
      "valign": "center",
      "lineHeight": 1.5,
      "wrap": true,
      "style": {
        "position": "absolute",
        "left": "0%",
        "top": "0%",
        "width": "100%",
        "zIndex": 50.0,
        "color": "#000000ff"
      },
      "text": "{gamelist.popup}",
      "visible": "{!(gamelist.popup == \"\")}"
    },

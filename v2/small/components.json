      "valign": "center",
      "lineHeight": 1.5,
      "style": {
        "position": "absolute",
        "left": 0,
        "width": "100%",
        "color": "$menuTextColor",
        "top": 0,
        "height": "{(menu.subtitle != \"\" ? (fontCapHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.0333333 * min(screen.w, screen.h)), 1) + 0.05 * screen.h) + 0.019 * screen.h : fontCapHeight(\"$(themeDir)/../../_inc/fonts/Inter-Bold.otf\", (0.0333333 * min(screen.w, screen.h)), 1) + 0.0637 * screen.h)}"
      }
    },
    // used by def md_rating
    "md_rating-unfilled": {
      "type": "box",
      "style": {
        "position": "absolute",
        "left": 0,
        "top": 0,
        "height": "100%",
        "flexDirection": "row",
        "width": "100%"
      },
      "children": [
        {"use": "star1"},
        {"use": "star2"},
        {"use": "star3"},
        {"use": "star4"},
        {"use": "star5"}
      ],
      "id": "md_rating-unfilled"

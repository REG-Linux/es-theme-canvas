      "font": "../../_inc/fonts/Inter-Regular.otf",
      "fontSize": "$font-size/fontSize.2",
      "valign": "center",
      "lineHeight": 1.2,
      "style": {
        "position": "absolute",
        "left": "$font-size/left.8",

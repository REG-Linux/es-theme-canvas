    // used by def help
    "icon": {
      "type": "image",
      "id": "icon",
      "src": "{firstFile(item.button == \"a\" ? \"$(themeDir)/../../_inc/images/buttons/help-button-east.svg\" : item.button == \"b\" ? \"$(themeDir)/../../_inc/images/buttons/help-button-south.svg\" : item.button == \"x\" ? \"$(themeDir)/../../_inc/images/buttons/help-button-north.svg\" : item.button == \"y\" ? \"$(themeDir)/../../_inc/images/buttons/help-button-west.svg\" : \"\", item.icon)}",
      "tint": "$helpIconColor",
      "font": "../../_inc/fonts/Inter-Bold.otf",
      "fontSize": "2.8vmin",
      "style": {"height": "{round(1.25 * self.capHeight)}", "margin": [0, "0.42vw", 0, 0]}
    },
    // used by def help
    "label": {
      "type": "text",
      "id": "label",
      "text": "{screen.w / screen.h < 1.4 ? item.labelShort : item.label}",
      "transform": "uppercase",
      "font": "../../_inc/fonts/Inter-Bold.otf",
      "fontSize": "2.8vmin",
      "lineHeight": 1.5,
      "style": {"color": "$helpIconColor", "flexShrink": 0}
    },
    // used by def gamelist
    "selector": {
      "type": "box",
      "id": "selector",
      "visible": false,
      "style": {
        "position": "absolute",
        "left": 0,
        "top": 0,
        "width": "100%",
        "height": "$font-size/height.3",
        "background": "$gamelistSelectorColor"
      },
      "states": {"selected": {"style": {"visible": true}}}
    },
    // used by gamelist/basic, gamelist/detailed, gamelist/gamecarousel, gamelist/grid
    "logo": {
      "type": "image",
      "id": "logo",
      "fit": "contain",
      "position": ["50%", "50%"],
      "src": "../../_inc/systems/logos/{system.theme}.svg",
      "style": {
        "position": "absolute",
        "left": "25.5%",
        "top": "88%",
        "maxWidth": "25%",
        "maxHeight": "8%",
        "translate": ["-50%", "-50%"],
        "opacity": 0.8,
        "zIndex": 2.0
      },
      "visible": "{gamelist.popup == \"\"}",
      "tint": "$systemInfoColor"
    },
    // used by def md_rating-filled, def md_rating-unfilled
    "star1": {
      "type": "image",
      "id": "star1",
      "src": "../../_inc/images/icons/icon-star-unfilled.svg",
      "tint": "$gameMetadataColor",
      "style": {"width": "20%", "height": "100%"}
    },
    // used by def md_rating-filled, def md_rating-unfilled
    "star2": {
      "type": "image",
      "id": "star2",
      "src": "../../_inc/images/icons/icon-star-unfilled.svg",
      "tint": "$gameMetadataColor",
      "style": {"width": "20%", "height": "100%"}
    },
    // used by def md_rating-filled, def md_rating-unfilled
    "star3": {
      "type": "image",
      "id": "star3",
      "src": "../../_inc/images/icons/icon-star-unfilled.svg",
      "tint": "$gameMetadataColor",
      "style": {"width": "20%", "height": "100%"}
    },
    // used by def md_rating-filled, def md_rating-unfilled
    "star4": {
      "type": "image",
      "id": "star4",
      "src": "../../_inc/images/icons/icon-star-unfilled.svg",
      "tint": "$gameMetadataColor",
      "style": {"width": "20%", "height": "100%"}
    },

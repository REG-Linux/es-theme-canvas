      "position": ["50%", "50%"],
      "src": "{game.video}",
      "style": {
        "position": "absolute",
        "left": "$aspect-ratio/left.3",
        "top": "$metadata/top.3",
        "maxWidth": "$aspect-ratio/maxWidth.1",
        "maxHeight": "$aspect-ratio/maxHeight.1",
        "translate": ["-50%", "-50%"],
        "zIndex": 7.0
      },
      "poster": "{firstFile(game.image, game.thumbnail)}",
      "delay": 1400.0,
      "showPoster": 3
    },
    // used by gamelist/detailed, gamelist/gamecarousel, gamelist/grid
    "playtime-logo": {
      "type": "image",
      "id": "playtime-logo",
      "visible": "$metadata-option/visible.1",
      "src": "../../_inc/images/icons/playtime-icon.svg",
      "tint": "$gameMetadataColor",
      "style": {
        "position": "absolute",
        "left": "$metadata/left.1",
        "top": "$metadata/top.1",
        "height": "$metadata/height.1",
        "translate": ["-50%", "-50%"],
        "opacity": 0.6,
        "zIndex": 2.0
      }
    }
  }

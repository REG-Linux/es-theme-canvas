<theme>
  <formatVersion>7</formatVersion>
  <!--
  Dual-screen devices: the other screen shows the selected system and game, so
  the system view drops its game count, and the gamelists their media and
  metadata (the list takes the width).
  -->

  <!-- The system view's game count (top-left): the other screen shows it -->
  <view name="system" ifDualScreen="true">
    <image name="gamesicon" extra="true">
      <visible>false</visible>
    </image>

    <text name="systemInfo" extra="true">
      <visible>false</visible>
    </text>
  </view>

  <view name="detailed, gamecarousel, grid" ifDualScreen="true">
    <video name="md_video">
      <visible>false</visible>
    </video>

    <image name="md_marquee,md_image,md_thumbnail">
      <visible>false</visible>
    </image>

    <image name="game-metadata-background-shadow-base,game-metadata-background-image-base,game-metadata-background-shadow-extended,game-metadata-background-image-extended,playtime-logo" extra="true">
      <visible>false</visible>
    </image>

    <datetime name="md_releasedate,md_lastplayed">
      <visible>false</visible>
    </datetime>

    <text name="md_name,md_players,md_genre,md_developer,md_publisher,md_playcount,md_gametime_custom,md_description">
      <visible>false</visible>
    </text>

    <rating name="md_rating">
      <visible>false</visible>
    </rating>
  </view>

  <view name="basic, detailed" ifDualScreen="true">
    <image name="logo">
      <origin>0.5 0.5</origin>
      <pos>0.5 0.50648148147</pos>
      <maxSize>0.6 0.4</maxSize>
      <zIndex>3</zIndex>
    </image>

    <image name="console-icon" extra="true">
      <visible>false</visible>
    </image>

    <image name="game-list-background-shadow" extra="true">
      <pos>0.5 0.50648148147</pos>
      <size>0.97 0.8972222528</size>
    </image>

    <image name="game-list-background" extra="true">
      <pos>0.5 0.50648148147</pos>
      <size>0.94 0.84166666666</size>
    </image>

    <textlist name="gamelist">
      <pos>0.05 0.118</pos>
      <size>0.9 0.786</size>
    </textlist>
  </view>
</theme>

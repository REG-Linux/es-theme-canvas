<theme>
  <formatVersion>7</formatVersion>

  <!--
    3:2 aspect ratio variables, based on 720x480 (RG34XX and similar handhelds).

    Geometry values come from the upstream canvas-es 3:2 support (PR #13 by
    viczaca); the file structure, variable set and ${themePath} paths follow the
    other aspect-ratio files in this fork rather than upstream's, which uses
    relative ./ paths and carries per-subset font sizes this theme sets
    elsewhere. controllerActivityPos has no upstream counterpart and is taken
    from 16:10, the nearest ratio we ship (1.6 vs 1.5; 4:3 is 1.333).
  -->

  <variables ifSubset="font-size:small">
    <itemcount>3.5</itemcount>
    <itemsize>0.293 0.36</itemsize>
    <logospacing>1.2</logospacing>
    <gamelistBackgroundImageCalculated
      cache="true"
    >${themePath}/_inc/images/gamelist/${gamelistBackgroundImage}-small.webp</gamelistBackgroundImageCalculated>
    <gamelistSelectorHeight>0.041</gamelistSelectorHeight>
    <gamelistPos>0.557291666666667 0.117666666666667</gamelistPos>
    <gamelistSize>0.38375 0.786</gamelistSize>
    <itemSizeCarousel>0.22 0.27</itemSizeCarousel>
    <descriptionPos>0.69</descriptionPos>
    <descriptionHeight>0.135</descriptionHeight>
    <descriptionLineSpacing>1.35</descriptionLineSpacing>
    <linecount>16</linecount>
  </variables>

  <variables ifSubset="font-size:medium">
    <itemcount>3</itemcount>
    <itemsize>0.34 0.46</itemsize>
    <logospacing>0.2</logospacing>
    <gamelistBackgroundImageCalculated
      cache="true"
    >${themePath}/_inc/images/gamelist/${gamelistBackgroundImage}-medium.webp</gamelistBackgroundImageCalculated>
    <gamelistSelectorHeight>0.051388888888889</gamelistSelectorHeight>
    <gamelistPos>0.559591666666667 0.133666666666667</gamelistPos>
    <gamelistSize>0.38275 0.7515</gamelistSize>
    <itemSizeCarousel>0.22 0.27</itemSizeCarousel>
    <descriptionPos>0.656</descriptionPos>
    <descriptionHeight>0.155</descriptionHeight>
    <descriptionLineSpacing>1.5</descriptionLineSpacing>
    <linecount>12</linecount>
  </variables>

  <variables ifSubset="font-size:large">
    <itemcount>1.5</itemcount>
    <itemsize>0.44 0.54</itemsize>
    <logospacing>-0.75</logospacing>
    <gamelistBackgroundImageCalculated
      cache="true"
    >${themePath}/_inc/images/gamelist/${gamelistBackgroundImage}-large.webp</gamelistBackgroundImageCalculated>
    <gamelistSelectorHeight>0.066</gamelistSelectorHeight>
    <gamelistPos>0.559591666666667 0.129166666666667</gamelistPos>
    <gamelistSize>0.38275 0.763</gamelistSize>
    <itemSizeCarousel>0.22 0.27</itemSizeCarousel>
    <descriptionPos>0.656</descriptionPos>
    <descriptionHeight>0.155</descriptionHeight>
    <descriptionLineSpacing>1.6</descriptionLineSpacing>
    <linecount>10</linecount>
  </variables>

  <variables>
    <helpPos>0.97</helpPos>
    <CornersGrid>7</CornersGrid>
    <CornersSmall>14</CornersSmall>
    <CornersMedium>25</CornersMedium>
    <CornersLarge>45</CornersLarge>
    <controllerActivityPos>0.720</controllerActivityPos>
  </variables>

  <!-- Small Screens (480p-720p, e.g., 640x480, 800x600) -->
  <variables verticalScreen="true">
    <topBarFontSize>0.026</topBarFontSize>
    <bottomBarFontSize>0.026</bottomBarFontSize>
    <systemDescriptionFontSize>0.024</systemDescriptionFontSize>
    <systemYearFontSize>0.024</systemYearFontSize>
    <gamelistFontSize>0.024</gamelistFontSize>
    <metaDatafontSize>0.026</metaDatafontSize>
    <descriptionFontSize>0.024</descriptionFontSize>
  </variables>
</theme>
